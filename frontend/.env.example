# Copy to frontend/.env.local for local overrides. Read by Next.js.

# Where the browser sends API requests. Keep the default ("/api/v1") so requests
# go through the Next.js proxy and auth cookies stay first-party.
NEXT_PUBLIC_API_URL=/api/v1

# Where Next.js forwards /api/v1/* (server-side only).
# IMPORTANT: this is read at BUILD time (`next build`) and at `next dev` startup.
BACKEND_URL=http://127.0.0.1:8000

# Business details shown on the legal and contact pages. Leave unset to show
# visible [placeholders]. Email addresses become clickable mailto: links.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
# Defaults to the contact email when empty.
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_GOVERNING_LAW=

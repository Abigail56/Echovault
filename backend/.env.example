# Copy to backend/.env and fill in real values. Never commit backend/.env.
APP_NAME=EchoVault Nexus
# development | test | production
ENVIRONMENT=development

# --- Read by Docker Compose (docker-compose.yml) ---
# Used only the first time the database volume is created.
POSTGRES_PASSWORD=choose-a-long-random-password
# Host port for PostgreSQL (5433 avoids clashing with a system PostgreSQL on 5432).
POSTGRES_PORT=5433

# --- Read by FastAPI ---
# The password here must match the one inside the database.
DATABASE_URL=postgresql+psycopg://echovault:choose-a-long-random-password@127.0.0.1:5433/echovault
# Separate database used by pytest. Its name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://echovault:choose-a-long-random-password@127.0.0.1:5433/echovault_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Where the Next.js app runs (CORS + password-reset links).
FRONTEND_ORIGIN=http://localhost:3000
# Must be true in production (HTTPS).
COOKIE_SECURE=false
# true when requests arrive through the Next.js proxy or another trusted proxy.
TRUST_PROXY_HEADERS=true

# --- Optional: AI assistant (leave AI_PROVIDER empty to disable) ---
# anthropic          -> AI_API_KEY required; AI_MODEL defaults to claude-opus-5-5
# openai_compatible  -> AI_BASE_URL and AI_MODEL required (e.g. Ollama:
#                       AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=llama3.1)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Optional: SMTP for password-reset emails ---
# Local development: the Mailpit container in docker-compose.yml catches all
# mail; read it at http://localhost:8025. Use these values:
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_FROM=noreply@echovault.local  SMTP_STARTTLS=false
# Production: your email provider's SMTP settings (with SMTP_STARTTLS=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
